# =============================================================================
# VibeTrace environment variable template (committed to Git)
#
# Usage: cp .env.example .env.local  then edit as needed (.env.local is gitignored)
# Read by: Vite frontend, memory-worker (Python), OpenCode plugin (agent-cockpit)
# =============================================================================

# -----------------------------------------------------------------------------
# Two startup modes (pick one)
# -----------------------------------------------------------------------------
#
# [Manual dev] Run opencode serve yourself (default http://127.0.0.1:4096, no password):
#   1. cp .env.example .env.local  (or run scripts/use-manual-env.ps1)
#   2. Confirm OPENCODE_PROXY_TARGET / OPENCODE_BASE point to 4096
#   3. Do not keep VITE_OPENCODE_SERVER_PASSWORD lines (manual serve is usually unsecured)
#   4. npm run worker:py  &&  npm run dev
#
# [OpenCode desktop auto-launches VibeTrace] The plugin will:
#   - Rewrite OPENCODE_PROXY_TARGET / OPENCODE_BASE to the desktop app's actual port (not 4096)
#   - Write OPENCODE_SERVER_PASSWORD into .env.local (no manual entry needed)
#   - Restart Vite to avoid browser login dialogs
#   VIBETRACE_OPENCODE_MODE will be set to plugin

# -----------------------------------------------------------------------------
# OpenCode HTTP — manual dev defaults (4096)
# -----------------------------------------------------------------------------

# VIBETRACE_OPENCODE_MODE
#   manual: you start serve; plugin: desktop plugin writes values (automatic)
VIBETRACE_OPENCODE_MODE=manual

# VITE_OPENCODE_BASE
#   empty → Vite same-origin proxy (recommended). Non-empty → browser hits URL directly
VITE_OPENCODE_BASE=

# OPENCODE_PROXY_TARGET
#   Vite forwards /session, /global, etc. to this address. Manual dev uses 4096; desktop plugin rewrites
OPENCODE_PROXY_TARGET=http://127.0.0.1:4096

# OPENCODE_BASE
#   memory-worker calls OpenCode at this address; keep in sync with OPENCODE_PROXY_TARGET for manual dev
OPENCODE_BASE=http://127.0.0.1:4096

# VITE_OPENCODE_SERVER_PASSWORD / OPENCODE_SERVER_PASSWORD
#   Only needed for desktop / password-protected opencode serve. Omit for manual unsecured serve (plugin writes automatically)
# VITE_OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_PASSWORD=

# VITE_OPENCODE_SERVER_USERNAME / OPENCODE_SERVER_USERNAME
#   Basic auth username, default opencode (omit for manual no-password serve)
# VITE_OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_USERNAME=opencode

# VITE_OPENCODE_DEFAULT_MODEL
#   Deprecated for send path — VibeTrace always uses dropdown selection, else
#   src/config/opencodeDefaults.ts (`opencode/big-pickle`). Kept for reference only.
# VITE_OPENCODE_DEFAULT_MODEL=opencode/big-pickle

# MW_OPENCODE_MODEL
#   Explicit model for all memory-worker → OpenCode prompts (task-switch / analyzer /
#   writer / panel-analysis / skill_evolve HTTP path). Must be providerID/modelID.
#   Default: opencode/big-pickle (same free default as the composer). Never omit —
#   omitting would fall back to the user's OpenCode config and often errors.
# MW_OPENCODE_MODEL=opencode/big-pickle

# VITE_OPENCODE_DEFAULT_AGENT
#   Optional default agent field in request body
# VITE_OPENCODE_DEFAULT_AGENT=

# VITE_OPENCODE_DIRECTORY_SEEDS
#   Optional workspace directory seeds, comma-separated absolute paths
# VITE_OPENCODE_DIRECTORY_SEEDS=

# VITE_OPENCODE_FETCH_TIMEOUT_MS
#   OpenCode fetch timeout (ms); ≤0 disables timeout; default 45000
# VITE_OPENCODE_FETCH_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Memory Worker — frontend
# -----------------------------------------------------------------------------

# VITE_MEMORY_WORKER_BASE
#   Frontend URL for memory-worker, e.g. http://127.0.0.1:8714
#   empty: use Vite proxy like OpenCode (/health, /ingest-trace)
VITE_MEMORY_WORKER_BASE=

# VITE_TRACE_SESSION_TURN_LIMIT
#   Session turn count packed on ingest (`current_turn` + `history`)
#   default 5: current turn first, then older history turns
VITE_TRACE_SESSION_TURN_LIMIT=5

# MEMORY_WORKER_PROXY_TARGET (maintained by plugin)
#   Vite proxy target for memory-worker, default http://127.0.0.1:8714
# MEMORY_WORKER_PROXY_TARGET=http://127.0.0.1:8714

# -----------------------------------------------------------------------------
# Memory Worker — Python (memory_worker/server.py)
# -----------------------------------------------------------------------------

# MEMORY_WORKER_PORT
#   Worker listen port; parsed from VITE_MEMORY_WORKER_BASE if unset, else default 8714
# MEMORY_WORKER_PORT=8714

# OPENCODE_DIRECTORY
#   OpenCode workspace directory (x-opencode-directory); default project root
OPENCODE_DIRECTORY=

# SKILL_WRITE_ROOT
#   Root where analyzed skills are written; empty → ~/.claude/skills
#   OpenCode-aligned options: project/.opencode/skills or ~/.config/opencode/skills
SKILL_WRITE_ROOT=

# MW_SKILL_PIPELINE
#   Skill distillation pipeline after a task switch (task segment → trace → skill on disk)
#
#   legacy (default on chinese branch)
#     Original analyzer + writer flow (run_analyzer → run_writer)
#     Uses MW_ANALYZER_MODE / MW_WRITER_MODE below
#     Confirm: GET /health → "skillPipeline": "legacy"
#
#   skill_evolve
#     Evidence → Estimator gate → Distiller → Scorer → apply patch
#     Logs: memory_worker/logs/<runId>/04-skill-evolve-*.json, 05-skill-evolve-*.json
#     Confirm: GET /health → "skillPipeline": "skill_evolve"
#
#   Opt in to skill_evolve (uncomment one line):
# MW_SKILL_PIPELINE=skill_evolve
#
#   Keep default legacy (comment out or omit):
MW_SKILL_PIPELINE=legacy

# MW_SKILL_EVOLVE_MODEL
#   Model for skill_evolve LLM steps (estimator / distiller / scorer)
#   empty → MW_OPENCODE_MODEL → OPENCODE_MODEL → opencode/big-pickle
# MW_SKILL_EVOLVE_MODEL=opencode/big-pickle

# SKILL_LOAD_ROOTS
#   Semicolon-separated skill scan roots (load pool + history); empty → built-in defaults:
#   <OPENCODE_DIRECTORY>/.opencode/skills, ~/.config/opencode/skills,
#   ~/.claude/skills, ~/.agents/skills, plus SKILL_WRITE_ROOT
# SKILL_LOAD_ROOTS=

# SKILL_SEARCH_ROOTS_EXTRA
#   Extra semicolon-separated roots appended to skill scan list
# SKILL_SEARCH_ROOTS_EXTRA=

# MW_ANALYZER_MODE
#   Trace analysis mode: opencode (OpenCode session) | mock (local fake data)
#   Used by legacy pipeline (MW_SKILL_PIPELINE=legacy); skill_evolve has its own prompts
MW_ANALYZER_MODE=opencode

# MW_ANALYZER_SESSION_ATTEMPTS
#   Max OpenCode sessions per LLM call on timeout/send failure; each retry opens a NEW session with the same prompt (task-switch / diagnosis / analyzer / feedback). Default 5
# MW_ANALYZER_SESSION_ATTEMPTS=5

# MW_TASK_SWITCH_MODE
#   After each turn, detect task switch from user prompt: opencode (default) | mock (local heuristic for testing)
#   First turn is recorded only; if no switch, accumulate; on switch, send prior task segment trace to Analyzer/Writer
# MW_TASK_SWITCH_MODE=opencode

# INGEST_DEDUP_FAILED_COOLDOWN_SEC
#   After failed ingest on same assistant stop, skip pipeline rerun for this many seconds (default 600)
# INGEST_DEDUP_FAILED_COOLDOWN_SEC=600

# MW_WRITER_MODE
#   Skill write mode: opencode | template (local template fallback)
#   Used by legacy pipeline (MW_SKILL_PIPELINE=legacy)
MW_WRITER_MODE=opencode

# MW_SESSION_STRATEGY
#   OpenCode session strategy when worker calls OpenCode: new | fork (from current session)
MW_SESSION_STRATEGY=new

# MW_SESSION_TITLE_PREFIX
#   Title prefix for OpenCode sessions created by memory-worker; frontend skips skill distillation UI for these
MW_SESSION_TITLE_PREFIX=[mw-internal]

# MW_CORS_ORIGINS
#   Allowed frontend origins for worker CORS, semicolon-separated
MW_CORS_ORIGINS=http://localhost:5173;http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Plugin / debugging (optional)
# -----------------------------------------------------------------------------

# VIBETRACE_NO_BROWSER
#   Set to 1 to prevent plugin from auto-opening browser
# VIBETRACE_NO_BROWSER=1

# PYTHON
#   Python executable for memory-worker (default Windows: python, Unix: python3)
# PYTHON=python3

# VITE_DEBUG_VERBOSE_LOGS
#   Set to 1 for more verbose frontend debug logs
# VITE_DEBUG_VERBOSE_LOGS=1
