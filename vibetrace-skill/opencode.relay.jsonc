{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "relay": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "deepseek official",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-chat": { "name": "DeepSeek Chat" },
        "deepseek-v4-flash": { "name": "DeepSeek v4 Flash" },
        "deepseek-v4-pro": { "name": "DeepSeek v4 Pro" }
      }
    }
  },
  "permission": {
    "external_directory": { "*": "deny" }
  },
  "agent": {
    "oneshot": {
      "description": "Pure single-shot text and JSON generation without tools.",
      "mode": "primary",
      "prompt": "You are a single-shot text generator, NOT an interactive coding agent. You have NO tools and NO repository access. Do NOT say you will explore, inspect, or open files. Answer the request COMPLETELY in ONE message using only the information given, then stop.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": false,
        "grep": false,
        "glob": false,
        "list": false,
        "webfetch": false,
        "task": false,
        "patch": false,
        "todowrite": false,
        "todoread": false
      }
    }
  }
}
